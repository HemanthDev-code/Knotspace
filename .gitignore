@'
# Dependencies
node_modules/
**/node_modules/

# Build output
dist/
**/dist/
dist-ssr/

# Environment files and secrets
.env
.env.*
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Local files
*.local

# Editor settings
.vscode/
.idea/

# Operating system files
.DS_Store
Thumbs.db
'@ | Set-Content -Path .gitignore -Encoding utf8